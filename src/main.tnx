import jgrep.json_value;
import jgrep.json_parser;
import jgrep.yaml_parser;
import jgrep.filter;
import jgrep.evaluator;
import jgrep.ndjson;
import jgrep.file_walker;
import jgrep.color;
import jgrep.matcher;

class CliOptions
{
    var filterExpr: String;
    var files: List<String>;
    var recursive: Bool;
    var filesWithMatches: Bool;
    var count: Bool;
    var slurp: Bool;
    var nullInput: Bool;
    var fromFile: String;
    var pretty: Bool;
    var colorLevel: Bool;
    var colorLevelField: String;
    var noColor: Bool;
    var showHelp: Bool;
    var showVersion: Bool;
    var completionShell: String;
    var yamlFlag: Bool;
    var jsonFlag: Bool;
    var yamlInput: Bool;
    var progName: String;

    fnc defaults() -> CliOptions
    {
        return CliOptions {
            filterExpr: ".",
            files: [],
            recursive: false,
            filesWithMatches: false,
            count: false,
            slurp: false,
            nullInput: false,
            fromFile: "",
            pretty: false,
            colorLevel: false,
            colorLevelField: "",
            noColor: false,
            showHelp: false,
            showVersion: false,
            completionShell: "",
            yamlFlag: false,
            jsonFlag: false,
            yamlInput: false,
            progName: "jgrep"
        };
    }
}

class ArgParser
{
    fnc parse(args: List<String>) -> CliOptions
    {
        var opts = CliOptions::defaults();
        var i = 0;
        var filterSet = false;

        while i < args.len()
        {
            let arg = args[i];

            if arg == "-h" || arg == "--help"
            {
                opts.showHelp = true;
                i = i + 1;
            }
            else if arg == "-V" || arg == "--version"
            {
                opts.showVersion = true;
                i = i + 1;
            }
            else if arg == "-r" || arg == "--recursive"
            {
                opts.recursive = true;
                i = i + 1;
            }
            else if arg == "-l" || arg == "--files-with-matches"
            {
                opts.filesWithMatches = true;
                i = i + 1;
            }
            else if arg == "-c" || arg == "--count"
            {
                opts.count = true;
                i = i + 1;
            }
            else if arg == "-s" || arg == "--slurp"
            {
                opts.slurp = true;
                i = i + 1;
            }
            else if arg == "-n" || arg == "--null-input"
            {
                opts.nullInput = true;
                i = i + 1;
            }
            else if arg == "--pretty"
            {
                opts.pretty = true;
                i = i + 1;
            }
            else if arg == "--color-level"
            {
                opts.colorLevel = true;
                i = i + 1;
            }
            else if arg == "--color-level-field"
            {
                i = i + 1;
                if i < args.len() { opts.colorLevelField = args[i]; }
                i = i + 1;
            }
            else if arg == "--no-color"
            {
                opts.noColor = true;
                i = i + 1;
            }
            else if arg == "--yaml"
            {
                opts.yamlFlag = true;
                i = i + 1;
            }
            else if arg == "--json"
            {
                opts.jsonFlag = true;
                i = i + 1;
            }
            else if arg == "-f" || arg == "--from-file"
            {
                i = i + 1;
                if i < args.len() { opts.fromFile = args[i]; }
                i = i + 1;
            }
            else if arg == "completion"
            {
                i = i + 1;
                if i < args.len() { opts.completionShell = args[i]; }
                i = i + 1;
            }
            else if arg.startsWith("-")
            {
                let flags = arg.substring(1, arg.len());
                var fi: Int64 = 0;
                while fi < flags.len()
                {
                    let fcode = flags[fi] as Int64;
                    if fcode == 114 { opts.recursive = true; }
                    else if fcode == 108 { opts.filesWithMatches = true; }
                    else if fcode == 99 { opts.count = true; }
                    else if fcode == 115 { opts.slurp = true; }
                    else if fcode == 110 { opts.nullInput = true; }
                    else if fcode == 104 { opts.showHelp = true; }
                    else if fcode == 86 { opts.showVersion = true; }
                    fi = fi + 1;
                }
                i = i + 1;
            }
            else
            {
                if filterSet == false && opts.fromFile == ""
                {
                    opts.filterExpr = arg;
                    filterSet = true;
                }
                else
                {
                    opts.files.push(arg);
                }
                i = i + 1;
            }
        }

        return opts;
    }
}

class JGrep
{
    var hadMatch: Bool;
    var hadError: Bool;
    var slurpResults: List<JsonValue>;
    var colorConfig: ColorConfig;
    var compiledFilter: Filter;
    var opts: CliOptions;
    var matcher: Matcher;

    fnc new(opts: CliOptions) -> JGrep
    {
        let colorEnabled = ColorConfig::detectEnabled(opts.noColor);
        let colorCfg = ColorConfig::new(colorEnabled, opts.colorLevel, opts.colorLevelField);

        var filterSrc = opts.filterExpr;
        if opts.fromFile != ""
        {
            let fromFileRaw = fileReadAllText(opts.fromFile);
            filterSrc = fromFileRaw.trim();
        }

        let compiled = FilterParser::compile(filterSrc);

        return JGrep {
            hadMatch: false,
            hadError: false,
            slurpResults: [],
            colorConfig: colorCfg,
            compiledFilter: compiled,
            opts: opts,
            matcher: Matcher::new()
        };
    }

    fn formatOutput(value: JsonValue) -> String
    {
        match value
        {
            Str(s) =>
            {
                if this.opts.colorLevel
                {
                    return LevelColorizer::colorizeByLevel(s, JsonValue::Null, this.colorConfig);
                }
                return s;
            }
            _ =>
            {
                if this.colorConfig.enabled
                {
                    if this.opts.pretty
                    {
                        return JsonHighlighter::highlightPrettyValue(value, 0);
                    }
                    return JsonHighlighter::highlightValue(value);
                }
                if this.opts.pretty { return JsonSerializer::prettyStringify(value, 2); }
                return JsonSerializer::stringify(value);
            }
        }
        return "";
    }

    fn printLine(prefix: String, line: String, sourceValue: JsonValue)
    {
        var output = line;
        if this.opts.colorLevel
        {
            output = LevelColorizer::colorizeByLevel(line, sourceValue, this.colorConfig);
        }
        if prefix == "" { println(output); }
        else { println(prefix + ":" + output); }
    }

    fn processDocument(doc: JsonValue, prefix: String, countRef: Int64) -> Int64
    {
        this.matcher.noteDocRead();
        let results = this.matcher.matchRaw(this.compiledFilter, doc);

        if results.len() > 0 { this.hadMatch = true; }

        if this.opts.slurp
        {
            for v in results { this.slurpResults.push(v); }
            return countRef + results.len();
        }

        if this.opts.filesWithMatches
        {
            if results.len() > 0 { return countRef + 1; }
            return countRef;
        }

        if this.opts.count
        {
            return countRef + results.len();
        }

        for v in results
        {
            let formatted = this.formatOutput(v);
            this.printLine(prefix, formatted, doc);
        }
        return countRef;
    }

    fn isYamlSource(path: String) -> Bool
    {
        if path == "" { return this.opts.yamlInput; }
        if FileWalker::isYamlFile(path) { return true; }
        if FileWalker::isJsonFile(path) { return false; }
        return this.opts.yamlInput;
    }

    fn docsFromContent(path: String, content: String) -> List<JsonValue>
    {
        var docs: List<JsonValue> = [];
        if this.isYamlSource(path)
        {
            let yres = YamlParser::parseAllTracked(content);
            if yres.errorCount > 0
            {
                this.hadError = true;
                var label = path;
                if label == "" { label = "<stdin>"; }
                printStderr(this.opts.progName + ": " + label + ": YAML parse error: " + yres.errorMsg);
            }
            docs = yres.docs;
        }
        else
        {
            let reader = NdjsonReader::fromString(content);
            while reader.hasNext()
            {
                let docList = reader.tryParseNext();
                if docList.len() == 0 { this.hadError = true; }
                else { docs.push(docList[0]); }
            }
        }
        return docs;
    }

    fn processSource(path: String, content: String, prefix: String)
    {
        let docs = this.docsFromContent(path, content);
        var count: Int64 = 0;

        for doc in docs
        {
            count = this.processDocument(doc, prefix, count);
            if this.opts.filesWithMatches && count > 0 { break; }
        }

        if this.opts.filesWithMatches
        {
            if count > 0 && path != "" { println(path); }
            return;
        }

        if this.opts.count
        {
            if prefix == "" { println(count.toString()); }
            else { println(prefix + ":" + count.toString()); }
        }
    }

    fn populateInputQueue()
    {
        var queue: List<JsonValue> = [];
        if this.opts.files.len() > 0
        {
            let allFiles = FileWalker::listFilesMode(this.opts.files, this.opts.recursive, this.opts.yamlInput);
            for fp in allFiles
            {
                if fileExists(fp)
                {
                    let content = fileReadAllText(fp);
                    let docs = this.docsFromContent(fp, content);
                    for d in docs { queue.push(d); }
                }
            }
        }
        else if isStdinTty() == 0
        {
            let stdinContent = fileReadAllText("/dev/stdin");
            let docs = this.docsFromContent("", stdinContent);
            for d in docs { queue.push(d); }
        }
        this.matcher.setInputQueue(queue);
    }

    fn processNullInput()
    {
        this.populateInputQueue();
        let evalResult = this.matcher.runEval(this.compiledFilter, JsonValue::Null);
        if evalResult.isError()
        {
            println("Error: " + evalResult.errorMsg);
            this.hadError = true;
            return;
        }
        if evalResult.values.len() > 0 { this.hadMatch = true; }

        if this.opts.slurp
        {
            for v in evalResult.values { this.slurpResults.push(v); }
            return;
        }

        for v in evalResult.values
        {
            let formatted = this.formatOutput(v);
            println(formatted);
        }
    }

    fn run() -> Int64
    {
        if this.opts.nullInput
        {
            this.processNullInput();
        }
        else if this.opts.files.len() == 0
        {
            let content = fileReadAllText("/dev/stdin");
            this.processSource("", content, "");
        }
        else
        {
            let allFiles = FileWalker::listFilesMode(this.opts.files, this.opts.recursive, this.opts.yamlInput);
            let usePrefix = allFiles.len() > 1;

            for filePath in allFiles
            {
                var skipFile = false;
                if !fileExists(filePath)
                {
                    println(this.opts.progName + ": " + filePath + ": No such file or directory");
                    this.hadError = true;
                    skipFile = true;
                }
                if !skipFile
                {
                    let content = fileReadAllText(filePath);
                    var prefix: String = "";
                    if usePrefix { prefix = filePath; }
                    this.processSource(filePath, content, prefix);
                }
            }
        }

        if this.opts.slurp
        {
            let arrValue = JsonValue::Array(this.slurpResults);
            let formatted = this.formatOutput(arrValue);
            println(formatted);
        }

        if this.hadError { return 2; }
        if !this.hadMatch { return 1; }
        return 0;
    }
}

class CompletionGenerator
{
    fnc generate(shell: String, prog: String) -> Int64
    {
        if shell == "bash"
        {
            println("# " + prog + " bash completion");
            println("_" + prog + "_complete() {");
            println("  local cur flags");
            println("  cur=\"" + "$" + "{COMP_WORDS[COMP_CWORD]}\"");
            println("  flags=\"-r -l -c -s -n -f --recursive --files-with-matches --count --slurp --null-input --from-file --pretty --color-level --color-level-field --no-color --yaml --json\"");
            println("  COMPREPLY=($(" + "compgen -W \"" + "$" + "flags\" -- \"" + "$" + "cur\") $(" + "compgen -f -- \"" + "$" + "cur\"))");
            println("}");
            println("complete -F _" + prog + "_complete " + prog);
            return 0;
        }
        if shell == "zsh"
        {
            println("#compdef " + prog);
            println("_" + prog + "() {");
            println("  _arguments \\");
            println("    '(-r --recursive)-r[recurse into directories]' \\");
            println("    '(-l --files-with-matches)-l[print only matching filenames]' \\");
            println("    '(-c --count)-c[print match count]' \\");
            println("    '(-s --slurp)-s[slurp all results into array]' \\");
            println("    '(-n --null-input)-n[use null as input]' \\");
            println("    '(-f --from-file)-f[read filter from file]:file:_files' \\");
            println("    '--pretty[pretty-print JSON]' \\");
            println("    '--color-level[colorize by log level]' \\");
            println("    '--color-level-field[log level field]:field' \\");
            println("    '--no-color[disable color]' \\");
            println("    '--yaml[treat input as YAML]' \\");
            println("    '--json[treat input as JSON]' \\");
            println("    ':filter:' \\");
            println("    '*:file:_files'");
            println("}");
            println("_" + prog + " \"" + "$" + "@\"");
            return 0;
        }
        if shell == "fish"
        {
            println("complete -c " + prog + " -s r -l recursive -d 'Recurse into directories'");
            println("complete -c " + prog + " -s l -l files-with-matches -d 'Print only matching filenames'");
            println("complete -c " + prog + " -s c -l count -d 'Print match count per file'");
            println("complete -c " + prog + " -s s -l slurp -d 'Collect all results into one array'");
            println("complete -c " + prog + " -s n -l null-input -d 'Use null as input'");
            println("complete -c " + prog + " -s f -l from-file -d 'Read filter from file' -r");
            println("complete -c " + prog + " -l pretty -d 'Pretty-print JSON output'");
            println("complete -c " + prog + " -l color-level -d 'Colorize by log level'");
            println("complete -c " + prog + " -l color-level-field -d 'Log level field' -r");
            println("complete -c " + prog + " -l no-color -d 'Disable color output'");
            println("complete -c " + prog + " -l yaml -d 'Treat input as YAML'");
            println("complete -c " + prog + " -l json -d 'Treat input as JSON'");
            return 0;
        }
        if shell == "powershell"
        {
            println("Register-ArgumentCompleter -Native -CommandName " + prog + " -ScriptBlock {");
            println("  param(" + "$" + "wordToComplete, " + "$" + "commandAst, " + "$" + "cursorPosition)");
            println("  " + "$" + "flags = @('-r','-l','-c','-s','-n','-f','--recursive','--files-with-matches',");
            println("             '--count','--slurp','--null-input','--from-file','--pretty',");
            println("             '--color-level','--color-level-field','--no-color','--yaml','--json')");
            println("  " + "$" + "flags | Where-Object { " + "$" + "_ -like \"" + "$" + "wordToComplete*\" } |");
            println("    ForEach-Object { [System.Management.Automation.CompletionResult]::new(" + "$" + "_) }");
            println("}");
            return 0;
        }
        println("Unsupported shell: " + shell);
        return 2;
    }
}

fn printHelp(prog: String)
{
    var desc = "grep for JSON — powered by Tinox";
    var dataExt = "json";
    if prog == "ygrep" { desc = "grep for YAML — powered by Tinox"; dataExt = "yaml"; }
    println("Usage: " + prog + " [-rclsnhV] [-f FILE] [--pretty] [--color-level] [--color-level-field FIELD] [--no-color] [--yaml|--json] [FILTER] [FILE...]");
    println("");
    println(desc);
    println("");
    println("Arguments:");
    println("  FILTER     jq filter expression (default: '.')");
    println("  FILE...    Files to search; reads stdin if omitted");
    println("");
    println("Options:");
    println("  -r, --recursive              Recurse into directories");
    println("  -l, --files-with-matches     Only print filenames with matches");
    println("  -c, --count                  Print match count per file");
    println("  -s, --slurp                  Collect all results into a single array");
    println("  -n, --null-input             Use null as input (don't read files)");
    println("  -f, --from-file FILE         Read filter from file");
    println("      --pretty                 Pretty-print JSON output");
    println("      --color-level            Colorize output by log level field");
    println("      --color-level-field F    Override log level field (dot-notation)");
    println("      --no-color               Disable ANSI color output");
    println("      --yaml                   Treat stdin/unknown files as YAML");
    println("      --json                   Treat stdin/unknown files as JSON");
    println("  -h, --help                   Show this help");
    println("  -V, --version                Show version");
    println("");
    println("  completion SHELL             Generate shell completion (bash/zsh/fish/powershell)");
    println("");
    println("File extensions decide the input format: .yaml/.yml is parsed as YAML,");
    println(".json/.ndjson/.jsonl as JSON. For stdin the program name or --yaml/--json decides.");
    println("");
    println("Examples:");
    println("  " + prog + " '.name' data." + dataExt);
    println("  " + prog + " 'select(.level == \"ERROR\")' logs." + dataExt);
    println("  " + prog + " '.[] | select(.active) | .name' items." + dataExt);
    println("  " + prog + " -r '.id' ./data/");
    println("  " + prog + " -c '.' *." + dataExt);
    println("  " + prog + " --color-level '.' logs." + dataExt);
    if prog == "ygrep" { println("  echo 'x: 1' | ygrep '.x'"); }
    else { println("  echo '{\"x\":1}' | jgrep '.x'"); }
}

fn baseName(path: String) -> String
{
    var idx: Int64 = -1;
    var i: Int64 = 0;
    while i < path.len()
    {
        if (path[i] as Int64) == 47 { idx = i; }
        i = i + 1;
    }
    return path.substring(idx + 1, path.len());
}

fn main() -> Int64
{
    let allArgs = processArgs();

    var progName = "jgrep";
    if allArgs.len() > 0
    {
        let invoked = baseName(allArgs[0]);
        if invoked.endsWith("ygrep") { progName = "ygrep"; }
    }

    var args: List<String> = [];
    var i = 1;
    while i < allArgs.len() { args.push(allArgs[i]); i = i + 1; }

    if args.len() == 0
    {
        printHelp(progName);
        return 2;
    }

    let firstArg = args[0];
    if firstArg == "completion" && args.len() > 1
    {
        return CompletionGenerator::generate(args[1], progName);
    }

    var opts = ArgParser::parse(args);
    opts.progName = progName;
    opts.yamlInput = progName == "ygrep";
    if opts.yamlFlag { opts.yamlInput = true; }
    if opts.jsonFlag { opts.yamlInput = false; }

    if opts.showHelp
    {
        printHelp(progName);
        return 0;
    }

    if opts.showVersion
    {
        println(progName + " 1.0.0 (Tinox)");
        return 0;
    }

    if opts.count && opts.filesWithMatches
    {
        println(progName + ": --count and --files-with-matches are mutually exclusive");
        return 2;
    }

    var jgrep = JGrep::new(opts);
    return jgrep.run();
}
