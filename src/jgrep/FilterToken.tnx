module jgrep.filter;

import StringPart;

enum FilterToken
{
    Dot;
    DotDot;
    Pipe;
    Comma;
    Semicolon;
    Question;
    Colon;
    Plus;
    Minus;
    Star;
    Slash;
    Percent;
    EqEq;
    BangEq;
    Lt;
    Gt;
    LtEq;
    GtEq;
    LParen;
    RParen;
    LBracket;
    RBracket;
    LBrace;
    RBrace;
    AltOp;
    And;
    Or;
    Not;
    If;
    Then;
    Elif;
    Else;
    End;
    Try;
    Catch;
    Reduce;
    Foreach;
    As;
    Label;
    Break;
    Def;
    Import;
    Include;
    Module;
    Dollar;
    At;
    Recurse;
    Empty;
    Error;
    Ident(String);
    VarName(String);
    LabelName(String);
    IntLit(Int64);
    FloatLit(Float64);
    StrLit(String);
    InterpStr(List<StringPart>);
    Format(String);
    Assign;
    UpdateAssign;
    PlusAssign;
    MinusAssign;
    MulAssign;
    DivAssign;
    ModAssign;
    AltAssign;
    EOF;
}
