module jgrep.yaml_parser;

import json_value;
import json_parser;

class YamlParseResult
{
    var docs: List<JsonValue>;
    var errorCount: Int64;
    var errorMsg: String;
}

class YamlScalar
{
    fnc hexVal(ch: Int64) -> Int64
    {
        if ch >= 48 && ch <= 57 { return ch - 48; }
        if ch >= 97 && ch <= 102 { return ch - 97 + 10; }
        if ch >= 65 && ch <= 70  { return ch - 65 + 10; }
        return 0;
    }

    fnc escChar(e: Int64) -> String
    {
        if e == 110 { return "\n"; }
        if e == 116 { return "\t"; }
        if e == 114 { return "\r"; }
        if e == 98  { return "\x08"; }
        if e == 102 { return "\x0c"; }
        if e == 48  { return ""; }
        return JsonLexer::codePointToStr(e);
    }

    fnc unquoteDouble(text: String) -> String
    {
        var out = "";
        var i: Int64 = 1;
        while i < text.len()
        {
            let c = text[i] as Int64;
            if c == 34 { break; }
            if c == 92
            {
                i = i + 1;
                if i >= text.len() { break; }
                let e = text[i] as Int64;
                if e == 117
                {
                    var cp: Int64 = 0;
                    var k: Int64 = 0;
                    while k < 4 && i + 1 < text.len()
                    {
                        i = i + 1;
                        cp = cp * 16 + YamlScalar::hexVal(text[i] as Int64);
                        k = k + 1;
                    }
                    out = out + JsonLexer::codePointToStr(cp);
                }
                else { out = out + YamlScalar::escChar(e); }
            }
            else { out = out + text.charAt(i); }
            i = i + 1;
        }
        return out;
    }

    fnc unquoteSingle(text: String) -> String
    {
        var out = "";
        var i: Int64 = 1;
        while i < text.len()
        {
            let c = text[i] as Int64;
            if c == 39
            {
                if i + 1 < text.len() && (text[i + 1] as Int64) == 39
                {
                    out = out + "'";
                    i = i + 2;
                }
                else { break; }
            }
            else
            {
                out = out + text.charAt(i);
                i = i + 1;
            }
        }
        return out;
    }

    fnc isIntLiteral(text: String) -> Bool
    {
        let n = text.len();
        var i: Int64 = 0;
        if n == 0 { return false; }
        if (text[0] as Int64) == 45 { i = 1; }
        if i >= n { return false; }
        while i < n
        {
            let c = text[i] as Int64;
            if c < 48 || c > 57 { return false; }
            i = i + 1;
        }
        return true;
    }

    fnc isFloatLiteral(text: String) -> Bool
    {
        let n = text.len();
        var i: Int64 = 0;
        if n == 0 { return false; }
        if (text[0] as Int64) == 45 { i = 1; }
        var sawDigit = false;
        while i < n
        {
            let c = text[i] as Int64;
            if c >= 48 && c <= 57 { sawDigit = true; i = i + 1; }
            else { break; }
        }
        var sawDot = false;
        if i < n && (text[i] as Int64) == 46
        {
            sawDot = true;
            i = i + 1;
            while i < n
            {
                let c = text[i] as Int64;
                if c >= 48 && c <= 57 { sawDigit = true; i = i + 1; }
                else { break; }
            }
        }
        var sawExp = false;
        if i < n
        {
            let c = text[i] as Int64;
            if c == 101 || c == 69
            {
                if !sawDigit { return false; }
                sawExp = true;
                i = i + 1;
                if i < n
                {
                    let sc = text[i] as Int64;
                    if sc == 43 || sc == 45 { i = i + 1; }
                }
                var expDigits = false;
                while i < n
                {
                    let ec = text[i] as Int64;
                    if ec >= 48 && ec <= 57 { expDigits = true; i = i + 1; }
                    else { break; }
                }
                if !expDigits { return false; }
            }
        }
        if i != n { return false; }
        if !sawDigit { return false; }
        return sawDot || sawExp;
    }

    fnc plainScalar(text: String) -> JsonValue
    {
        if text.len() == 0 { return JsonValue::Null; }
        if text == "null" || text == "Null" || text == "NULL" || text == "~" { return JsonValue::Null; }
        if text == "true" || text == "True" || text == "TRUE" { return JsonValue::Bool(true); }
        if text == "false" || text == "False" || text == "FALSE" { return JsonValue::Bool(false); }
        if YamlScalar::isIntLiteral(text) { return JsonValue::Integer(text.toInt()); }
        if YamlScalar::isFloatLiteral(text) { return JsonValue::Float(text.toFloat()); }
        return JsonValue::Str(text);
    }

    fnc parseScalarText(text: String) -> JsonValue
    {
        if text.len() == 0 { return JsonValue::Null; }
        let c0 = text[0] as Int64;
        if c0 == 34 { return JsonValue::Str(YamlScalar::unquoteDouble(text)); }
        if c0 == 39 { return JsonValue::Str(YamlScalar::unquoteSingle(text)); }
        return YamlScalar::plainScalar(text);
    }

    fnc keyText(raw: String) -> String
    {
        if raw.len() == 0 { return ""; }
        let c0 = raw[0] as Int64;
        if c0 == 34 { return YamlScalar::unquoteDouble(raw); }
        if c0 == 39 { return YamlScalar::unquoteSingle(raw); }
        return raw;
    }
}

class YamlFlow
{
    var s: String;
    var sLen: Int64;
    var pos: Int64;
    var hasError: Bool;
    var errorMsg: String;

    fnc new(text: String) -> YamlFlow
    {
        return YamlFlow { s: text, sLen: text.len(), pos: 0, hasError: false, errorMsg: "" };
    }

    fn peek() -> Int64
    {
        if this.pos >= this.sLen { return 0; }
        return this.s[this.pos] as Int64;
    }

    fn skipSpaces()
    {
        while this.pos < this.sLen
        {
            let c = this.s[this.pos] as Int64;
            if c == 32 || c == 9 { this.pos = this.pos + 1; }
            else { break; }
        }
    }

    fn fail(msg: String)
    {
        this.hasError = true;
        this.errorMsg = msg;
    }

    fn parseValue() -> JsonValue
    {
        this.skipSpaces();
        let c = this.peek();
        if c == 0 { this.fail("Unexpected end of flow expression"); return JsonValue::Null; }
        if c == 91 { return this.parseList(); }
        if c == 123 { return this.parseMap(); }
        if c == 34 { return JsonValue::Str(this.readDouble()); }
        if c == 39 { return JsonValue::Str(this.readSingle()); }
        let t = this.readPlain(false);
        return YamlScalar::plainScalar(t);
    }

    fn parseList() -> JsonValue
    {
        this.pos = this.pos + 1;
        var arr: List<JsonValue> = [];
        this.skipSpaces();
        if this.peek() == 93 { this.pos = this.pos + 1; return JsonValue::Array(arr); }
        loop
        {
            let v = this.parseValue();
            arr.push(v);
            if this.hasError { break; }
            this.skipSpaces();
            let c = this.peek();
            if c == 44 { this.pos = this.pos + 1; }
            else if c == 93 { this.pos = this.pos + 1; break; }
            else { this.fail("Expected ',' or ']' in flow sequence"); break; }
        }
        return JsonValue::Array(arr);
    }

    fn parseMap() -> JsonValue
    {
        this.pos = this.pos + 1;
        var obj: Map<String, JsonValue> = @{};
        this.skipSpaces();
        if this.peek() == 125 { this.pos = this.pos + 1; return JsonValue::Object(obj); }
        loop
        {
            this.skipSpaces();
            var key = "";
            let kc = this.peek();
            if kc == 34 { key = this.readDouble(); }
            else if kc == 39 { key = this.readSingle(); }
            else { key = this.readPlain(true); }
            this.skipSpaces();
            if this.peek() == 58 { this.pos = this.pos + 1; }
            else { this.fail("Expected ':' in flow mapping"); break; }
            let v = this.parseValue();
            obj[key] = v;
            if this.hasError { break; }
            this.skipSpaces();
            let c2 = this.peek();
            if c2 == 44 { this.pos = this.pos + 1; }
            else if c2 == 125 { this.pos = this.pos + 1; break; }
            else { this.fail("Expected ',' or '}' in flow mapping"); break; }
        }
        return JsonValue::Object(obj);
    }

    fn readPlain(stopAtColon: Bool) -> String
    {
        var out = "";
        while this.pos < this.sLen
        {
            let c = this.peek();
            if c == 44 || c == 93 || c == 125 { break; }
            if stopAtColon && c == 58 { break; }
            out = out + this.s.charAt(this.pos);
            this.pos = this.pos + 1;
        }
        return out.trim();
    }

    fn readDouble() -> String
    {
        this.pos = this.pos + 1;
        var out = "";
        while this.pos < this.sLen
        {
            let c = this.s[this.pos] as Int64;
            this.pos = this.pos + 1;
            if c == 34 { return out; }
            if c == 92
            {
                if this.pos >= this.sLen { break; }
                let e = this.s[this.pos] as Int64;
                this.pos = this.pos + 1;
                if e == 117
                {
                    var cp: Int64 = 0;
                    var k: Int64 = 0;
                    while k < 4 && this.pos < this.sLen
                    {
                        cp = cp * 16 + YamlScalar::hexVal(this.s[this.pos] as Int64);
                        this.pos = this.pos + 1;
                        k = k + 1;
                    }
                    out = out + JsonLexer::codePointToStr(cp);
                }
                else { out = out + YamlScalar::escChar(e); }
            }
            else { out = out + this.s.charAt(this.pos - 1); }
        }
        this.fail("Unterminated double-quoted string");
        return out;
    }

    fn readSingle() -> String
    {
        this.pos = this.pos + 1;
        var out = "";
        while this.pos < this.sLen
        {
            let c = this.s[this.pos] as Int64;
            this.pos = this.pos + 1;
            if c == 39
            {
                if this.pos < this.sLen && (this.s[this.pos] as Int64) == 39
                {
                    out = out + "'";
                    this.pos = this.pos + 1;
                }
                else { return out; }
            }
            else { out = out + this.s.charAt(this.pos - 1); }
        }
        this.fail("Unterminated single-quoted string");
        return out;
    }
}

class YamlParser
{
    var rawLines: List<String>;
    var count: Int64;
    var pos: Int64;
    var hasError: Bool;
    var errorMsg: String;

    fnc new(docLines: List<String>) -> YamlParser
    {
        return YamlParser { rawLines: docLines, count: docLines.len(), pos: 0, hasError: false, errorMsg: "" };
    }

    fnc splitRawLines(content: String) -> List<String>
    {
        var lines: List<String> = [];
        var cur = "";
        var i: Int64 = 0;
        while i < content.len()
        {
            let c = content[i] as Int64;
            if c == 10 { lines.push(cur); cur = ""; }
            else if c == 13 { }
            else { cur = cur + content.charAt(i); }
            i = i + 1;
        }
        if cur.len() > 0 { lines.push(cur); }
        return lines;
    }

    fnc indentOf(line: String) -> Int64
    {
        var i: Int64 = 0;
        while i < line.len() && (line[i] as Int64) == 32 { i = i + 1; }
        return i;
    }

    fnc isBlankLine(line: String) -> Bool
    {
        return line.trim().len() == 0;
    }

    fnc trimRight(s: String) -> String
    {
        var n = s.len();
        while n > 0
        {
            let c = s[n - 1] as Int64;
            if c == 32 || c == 9 { n = n - 1; }
            else { break; }
        }
        return s.substring(0, n);
    }

    fnc stripComment(text: String) -> String
    {
        var inD = false;
        var inS = false;
        var cut: Int64 = -1;
        var i: Int64 = 0;
        while i < text.len()
        {
            let c = text[i] as Int64;
            if inD
            {
                if c == 92 { i = i + 1; }
                else if c == 34 { inD = false; }
            }
            else if inS
            {
                if c == 39 { inS = false; }
            }
            else if c == 34 { inD = true; }
            else if c == 39 { inS = true; }
            else if c == 35
            {
                if i == 0 { cut = 0; break; }
                let p = text[i - 1] as Int64;
                if p == 32 || p == 9 { cut = i; break; }
            }
            i = i + 1;
        }
        var result = text;
        if cut >= 0 { result = text.substring(0, cut); }
        return YamlParser::trimRight(result);
    }

    fnc isSeqItem(text: String) -> Bool
    {
        return text == "-" || text.startsWith("- ");
    }

    fnc findKeyColon(text: String) -> Int64
    {
        var inD = false;
        var inS = false;
        var depth: Int64 = 0;
        var i: Int64 = 0;
        while i < text.len()
        {
            let c = text[i] as Int64;
            if inD
            {
                if c == 92 { i = i + 1; }
                else if c == 34 { inD = false; }
            }
            else if inS
            {
                if c == 39 { inS = false; }
            }
            else if c == 34 { inD = true; }
            else if c == 39 { inS = true; }
            else if c == 91 || c == 123 { depth = depth + 1; }
            else if c == 93 || c == 125 { depth = depth - 1; }
            else if c == 58 && depth == 0
            {
                if i + 1 >= text.len() { return i; }
                let nx = text[i + 1] as Int64;
                if nx == 32 || nx == 9 { return i; }
            }
            i = i + 1;
        }
        return -1;
    }

    fnc flowBalanced(text: String) -> Bool
    {
        var inD = false;
        var inS = false;
        var depth: Int64 = 0;
        var i: Int64 = 0;
        while i < text.len()
        {
            let c = text[i] as Int64;
            if inD
            {
                if c == 92 { i = i + 1; }
                else if c == 34 { inD = false; }
            }
            else if inS
            {
                if c == 39 { inS = false; }
            }
            else if c == 34 { inD = true; }
            else if c == 39 { inS = true; }
            else if c == 91 || c == 123 { depth = depth + 1; }
            else if c == 93 || c == 125 { depth = depth - 1; }
            i = i + 1;
        }
        return depth <= 0;
    }

    fn indentOfLine(i: Int64) -> Int64
    {
        return YamlParser::indentOf(this.rawLines[i]);
    }

    fn lineText(i: Int64) -> String
    {
        let raw = this.rawLines[i];
        let ind = YamlParser::indentOf(raw);
        return YamlParser::stripComment(raw.substring(ind, raw.len()));
    }

    fn skipIgnorable()
    {
        while this.pos < this.count
        {
            if this.lineText(this.pos).len() == 0 { this.pos = this.pos + 1; }
            else { break; }
        }
    }

    fn fail(msg: String)
    {
        if !this.hasError
        {
            this.hasError = true;
            this.errorMsg = msg;
        }
    }

    fn parseNode() -> JsonValue
    {
        this.skipIgnorable();
        if this.pos >= this.count { return JsonValue::Null; }
        let ind = this.indentOfLine(this.pos);
        let text = this.lineText(this.pos);
        this.pos = this.pos + 1;
        if YamlParser::isSeqItem(text) { return this.parseSequenceFrom(text, ind); }
        let ci = YamlParser::findKeyColon(text);
        if ci >= 0 { return this.parseMappingFrom(text, ind); }
        return this.parseValueRest(text, ind);
    }

    fn parseChildValue(parentInd: Int64) -> JsonValue
    {
        this.skipIgnorable();
        if this.pos >= this.count { return JsonValue::Null; }
        let ind = this.indentOfLine(this.pos);
        if ind > parentInd { return this.parseNode(); }
        if ind == parentInd && YamlParser::isSeqItem(this.lineText(this.pos)) { return this.parseNode(); }
        return JsonValue::Null;
    }

    fn parseChildValueSeq(dashInd: Int64) -> JsonValue
    {
        this.skipIgnorable();
        if this.pos < this.count && this.indentOfLine(this.pos) > dashInd { return this.parseNode(); }
        return JsonValue::Null;
    }

    fn parseMappingFrom(firstText: String, ind: Int64) -> JsonValue
    {
        var obj: Map<String, JsonValue> = @{};
        var text = firstText;
        loop
        {
            let ci = YamlParser::findKeyColon(text);
            if ci < 0
            {
                this.fail("Expected 'key:' mapping entry");
                break;
            }
            let keyRaw = text.substring(0, ci).trim();
            let key = YamlScalar::keyText(keyRaw);
            var rest = "";
            if ci + 1 < text.len() { rest = text.substring(ci + 1, text.len()).trim(); }

            if rest.len() == 0 { obj[key] = this.parseChildValue(ind); }
            else { obj[key] = this.parseValueRest(rest, ind); }

            this.skipIgnorable();
            if this.pos >= this.count { break; }
            if this.indentOfLine(this.pos) != ind { break; }
            let t = this.lineText(this.pos);
            if YamlParser::isSeqItem(t) { break; }
            text = t;
            this.pos = this.pos + 1;
        }
        return JsonValue::Object(obj);
    }

    fn parseSequenceFrom(firstText: String, ind: Int64) -> JsonValue
    {
        var arr: List<JsonValue> = [];
        var text = firstText;
        loop
        {
            if text == "-"
            {
                arr.push(this.parseChildValueSeq(ind));
            }
            else
            {
                var k: Int64 = 1;
                while k < text.len() && (text[k] as Int64) == 32 { k = k + 1; }
                let rest = text.substring(k, text.len());
                let restInd = ind + k;
                arr.push(this.parseSeqItemValue(rest, restInd, ind));
            }

            this.skipIgnorable();
            if this.pos >= this.count { break; }
            if this.indentOfLine(this.pos) != ind { break; }
            let t = this.lineText(this.pos);
            if !YamlParser::isSeqItem(t) { break; }
            text = t;
            this.pos = this.pos + 1;
        }
        return JsonValue::Array(arr);
    }

    fn parseSeqItemValue(rest: String, restInd: Int64, dashInd: Int64) -> JsonValue
    {
        if YamlParser::isSeqItem(rest) { return this.parseSequenceFrom(rest, restInd); }
        let ci = YamlParser::findKeyColon(rest);
        if ci >= 0 { return this.parseMappingFrom(rest, restInd); }
        return this.parseValueRest(rest, dashInd);
    }

    fn parseValueRest(rest: String, parentInd: Int64) -> JsonValue
    {
        var r = rest;
        var stripping = true;
        while stripping && r.len() > 0
        {
            let a0 = r[0] as Int64;
            if a0 == 38 || a0 == 33
            {
                var j: Int64 = 0;
                while j < r.len() && (r[j] as Int64) != 32 && (r[j] as Int64) != 9 { j = j + 1; }
                if j >= r.len() { r = ""; }
                else { r = r.substring(j, r.len()).trim(); }
            }
            else { stripping = false; }
        }
        if r.len() == 0 { return this.parseChildValue(parentInd); }

        let c0 = r[0] as Int64;
        if c0 == 42 { return JsonValue::Null; }
        if c0 == 124 || c0 == 62
        {
            var okInd = true;
            var chomp: Int64 = 0;
            var j: Int64 = 1;
            while j < r.len()
            {
                let cj = r[j] as Int64;
                if cj == 45 { chomp = -1; }
                else if cj == 43 { chomp = 1; }
                else if cj >= 48 && cj <= 57 { }
                else { okInd = false; }
                j = j + 1;
            }
            if okInd { return this.parseBlockScalar(parentInd, c0 == 62, chomp); }
            return YamlScalar::parseScalarText(r);
        }
        if c0 == 91 || c0 == 123
        {
            let full = this.completeFlow(r);
            return this.parseFlow(full);
        }
        return YamlScalar::parseScalarText(r);
    }

    fn completeFlow(start: String) -> String
    {
        var full = start;
        while !YamlParser::flowBalanced(full) && this.pos < this.count
        {
            let t = this.lineText(this.pos);
            this.pos = this.pos + 1;
            full = full + " " + t;
        }
        if !YamlParser::flowBalanced(full) { this.fail("Unterminated flow collection"); }
        return full;
    }

    fn parseFlow(text: String) -> JsonValue
    {
        var f = YamlFlow::new(text);
        let v = f.parseValue();
        if f.hasError { this.fail(f.errorMsg); }
        return v;
    }

    fn parseBlockScalar(parentInd: Int64, folded: Bool, chomp: Int64) -> JsonValue
    {
        var contentInd: Int64 = -1;
        var collected: List<String> = [];
        while this.pos < this.count
        {
            let raw = this.rawLines[this.pos];
            if YamlParser::isBlankLine(raw)
            {
                collected.push("");
                this.pos = this.pos + 1;
            }
            else
            {
                let ind = YamlParser::indentOf(raw);
                if ind <= parentInd { break; }
                if contentInd < 0 { contentInd = ind; }
                var takeFrom = contentInd;
                if ind < contentInd { takeFrom = ind; }
                collected.push(raw.substring(takeFrom, raw.len()));
                this.pos = this.pos + 1;
            }
        }

        var endNonBlank: Int64 = collected.len();
        while endNonBlank > 0 && collected[endNonBlank - 1] == "" { endNonBlank = endNonBlank - 1; }
        let trailing = collected.len() - endNonBlank;

        var body = "";
        if folded
        {
            var i: Int64 = 0;
            var prevBlank = true;
            while i < endNonBlank
            {
                let ln = collected[i];
                if ln == ""
                {
                    body = body + "\n";
                    prevBlank = true;
                }
                else
                {
                    if i > 0 && !prevBlank { body = body + " "; }
                    body = body + ln;
                    prevBlank = false;
                }
                i = i + 1;
            }
        }
        else
        {
            var i: Int64 = 0;
            while i < endNonBlank
            {
                if i > 0 { body = body + "\n"; }
                body = body + collected[i];
                i = i + 1;
            }
        }

        if chomp == 0
        {
            if endNonBlank > 0 { body = body + "\n"; }
        }
        else if chomp > 0
        {
            body = body + "\n";
            var t: Int64 = 0;
            while t < trailing { body = body + "\n"; t = t + 1; }
        }
        return JsonValue::Str(body);
    }

    fnc parseDocLines(docLines: List<String>, out: YamlParseResult) -> Int64
    {
        var p = YamlParser::new(docLines);
        p.skipIgnorable();
        if p.pos >= p.count { return 0; }
        let v = p.parseNode();
        if !p.hasError
        {
            p.skipIgnorable();
            if p.pos < p.count
            {
                let lineNo = p.pos + 1;
                p.fail("Unexpected content at document line " + lineNo.toString());
            }
        }
        if p.hasError
        {
            out.errorCount = out.errorCount + 1;
            out.errorMsg = p.errorMsg;
        }
        else { out.docs.push(v); }
        return 0;
    }

    fnc parseAllTracked(content: String) -> YamlParseResult
    {
        var out = YamlParseResult { docs: [], errorCount: 0, errorMsg: "" };
        let lines = YamlParser::splitRawLines(content);
        var current: List<String> = [];
        var i: Int64 = 0;
        while i < lines.len()
        {
            let ln = lines[i];
            let t = YamlParser::trimRight(ln);
            if t == "---" || t == "..." || t.startsWith("... ")
            {
                YamlParser::parseDocLines(current, out);
                current = [];
            }
            else if ln.startsWith("--- ")
            {
                YamlParser::parseDocLines(current, out);
                current = [];
                current.push(ln.substring(4, ln.len()));
            }
            else if ln.startsWith("%") { }
            else { current.push(ln); }
            i = i + 1;
        }
        YamlParser::parseDocLines(current, out);
        return out;
    }

    fnc parseAll(content: String) -> List<JsonValue>
    {
        let r = YamlParser::parseAllTracked(content);
        return r.docs;
    }
}

class YamlReader
{
    var docs: List<JsonValue>;
    var pos: Int64;
    var errorCount: Int64;
    var errorMsg: String;

    fnc fromFile(path: String) -> YamlReader
    {
        let content = fileReadAllText(path);
        return YamlReader::fromString(content);
    }

    fnc fromString(content: String) -> YamlReader
    {
        let r = YamlParser::parseAllTracked(content);
        return YamlReader { docs: r.docs, pos: 0, errorCount: r.errorCount, errorMsg: r.errorMsg };
    }

    fn hasNext() -> Bool
    {
        return this.pos < this.docs.len();
    }

    fn tryParseNext() -> List<JsonValue>
    {
        if !this.hasNext() { return []; }
        let doc = this.docs[this.pos];
        this.pos = this.pos + 1;
        return [doc];
    }

    fn readAll() -> List<JsonValue>
    {
        var results: List<JsonValue> = [];
        while this.hasNext()
        {
            let r = this.tryParseNext();
            if r.len() > 0 { results.push(r[0]); }
        }
        return results;
    }
}
