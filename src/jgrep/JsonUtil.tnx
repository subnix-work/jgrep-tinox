module jgrep.json_value;

class JsonUtil
{
    fnc floatDisplay(f: Float64) -> String
    {
        if mathIsNan(f) != 0 { return "null"; }
        if mathIsInfinite(f) != 0
        {
            if f > 0.0 { return "1.7976931348623157e+308"; }
            return "-1.7976931348623157e+308";
        }
        let s = f.toString();
        if s.contains(".") { return s; }
        if s.contains("e") || s.contains("E") { return s; }
        return s + ".0";
    }

    fnc sortStringListInsert(sorted: List<String>, s: String) -> List<String>
    {
        var result: List<String> = [];
        var inserted = false;
        for r in sorted
        {
            if !inserted && s <= r
            {
                result.push(s);
                inserted = true;
            }
            result.push(r);
        }
        if !inserted { result.push(s); }
        return result;
    }

    fnc sortStringList(strs: List<String>) -> List<String>
    {
        var result: List<String> = [];
        for s in strs
        {
            result = sortStringListInsert(result, s);
        }
        return result;
    }
}
